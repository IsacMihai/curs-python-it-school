#5.Sa se scrie un program care primeste un folder si o extensie de fisier de la utilizator si parcurge recursiv folderul
# pentru a afisa numele tuturor fisierelor care au acea extensie.

import os

def cauta_fisiere(folder, extensie):

    #luam toate elementele
    elemente = os.listdir(folder)

    for element in elemente:

        #creem calea completa
        cale_completa = os.path.join(folder, element)

        #verificam daca este fisier
        if os.path.isfile(cale_completa):

            #verifica extensia
            if element.endswith(extensie):
                print(element)

        #verificam daca este folder
        elif os.path.isdir(cale_completa):

               #apel recursiv
               cauta_fisiere(cale_completa, extensie)

folder_user = input('Introdu calea folderului: ')
extensia_user = input('Introdu extensia: ')

cauta_fisiere(folder_user, extensia_user)
